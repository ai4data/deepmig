    SELECT
        SUM(CASE WHEN id IS NULL THEN 1 ELSE 0 END) as null_keys,
        COUNT(*) - COUNT(DISTINCT id) as duplicate_keys
    FROM northwind_migration.northwnd_gold.orders_fact
""")
