# DeepMig Environment Configuration
# Copy this file to .env and fill in your values
#
# LLM Provider can also be configured via config.yaml (see config.yaml.example)

# =============================================================================
# LLM Provider Selection
# =============================================================================
# Set this to choose your provider: azure, openai, anthropic, google, deepseek, qwen, zhipu
# LLM_PROVIDER=azure

# =============================================================================
# Provider API Keys (configure the one you're using)
# =============================================================================

# --- Azure OpenAI (Enterprise) ---
# Install: pip install deepmig[azure]
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Optional: Per-subagent model deployments (Azure only)
# AZURE_OPENAI_PLANNING_MODEL=gpt-4o
# AZURE_OPENAI_CRITIQUE_MODEL=gpt-4o
# AZURE_OPENAI_CODE_MODEL=gpt-4o
# AZURE_OPENAI_VALIDATOR_MODEL=gpt-4o

# --- OpenAI (Direct API) ---
# Install: pip install deepmig[openai]
# OPENAI_API_KEY=sk-your-key-here

# --- Anthropic Claude ---
# Install: pip install deepmig[anthropic]
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Google Gemini ---
# Install: pip install deepmig[google]
# GOOGLE_API_KEY=your-google-api-key

# --- Deepseek (Chinese, Cost-Effective) ---
# Install: pip install deepmig[deepseek]
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- Alibaba Qwen/Tongyi (Chinese) ---
# Install: pip install deepmig[qwen]
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# (or QWEN_API_KEY=...)

# --- Zhipu AI GLM (Chinese) ---
# Install: pip install deepmig[zhipu]
# ZHIPU_API_KEY=your-zhipu-key

# =============================================================================
# Source Database Configuration (for skills that connect to sources)
# =============================================================================

# SQL Server Source
# SQL_SERVER_HOST=your-server.database.windows.net
# SQL_SERVER_USER=your-username
# SQL_SERVER_PASSWORD=your-password
# SQL_SERVER_DATABASE_OLTP=your-database

# =============================================================================
# Target Platform Configuration (for skills that deploy to targets)
# =============================================================================

# Databricks Target
# DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
# DATABRICKS_TOKEN=dapi-your-token-here
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Snowflake Target (if using target-snowflake skill)
# SNOWFLAKE_ACCOUNT=your-account
# SNOWFLAKE_USER=your-username
# SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=your-database

# Microsoft Fabric Target (if using target-fabric skill)
# FABRIC_WORKSPACE_ID=your-workspace-guid
# FABRIC_LAKEHOUSE_NAME=your-lakehouse
# FABRIC_TENANT_ID=your-tenant-id
