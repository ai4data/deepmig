# DeepMig Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration (choose ONE)
# =============================================================================

# Option 1: Azure OpenAI (Recommended for enterprise)
# -------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Optional: Per-agent model deployments (Azure only)
# These allow you to use different models for different agents
# AZURE_OPENAI_PLANNING_MODEL=gpt-4o
# AZURE_OPENAI_CRITIQUE_MODEL=gpt-4o
# AZURE_OPENAI_CODE_MODEL=gpt-4o
# AZURE_OPENAI_VALIDATOR_MODEL=gpt-4o

# Option 2: OpenAI
# ----------------
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# Option 3: Anthropic
# -------------------
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Source Database Configuration (for skills that connect to sources)
# =============================================================================

# SQL Server Source
# SQL_SERVER_HOST=your-server.database.windows.net
# SQL_SERVER_USER=your-username
# SQL_SERVER_PASSWORD=your-password
# SQL_SERVER_DATABASE_OLTP=your-database

# =============================================================================
# Target Platform Configuration (for skills that deploy to targets)
# =============================================================================

# Databricks Target
# DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
# DATABRICKS_TOKEN=dapi-your-token-here
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Snowflake Target (if using target-snowflake skill)
# SNOWFLAKE_ACCOUNT=your-account
# SNOWFLAKE_USER=your-username
# SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=your-database

# Microsoft Fabric Target (if using target-fabric skill)
# FABRIC_WORKSPACE_ID=your-workspace-guid
# FABRIC_LAKEHOUSE_NAME=your-lakehouse
# FABRIC_TENANT_ID=your-tenant-id
